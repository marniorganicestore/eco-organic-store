JWT_SECRET=change-me-please-change-me-please-change-me-please
INTERNAL_API_KEY=internal-secret

# Browser origins allowed by the gateway (credentials CORS). Include the Azure storefront in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://eco-organic-store.com,https://www.eco-organic-store.com

# Cross-site SPA → API (default Azure hosts): COOKIE_SECURE=true and COOKIE_SAME_SITE=None
# After api.eco-organic-store.com is attached, Lax is enough (same-site).
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@harvest.co
ADMIN_NAME=Harvest Admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

IDENTITY_MONGODB_URI=mongodb://localhost:27017/identity
CATALOG_MONGODB_URI=mongodb://localhost:27017/catalog
INVENTORY_MONGODB_URI=mongodb://localhost:27017/inventory
CART_MONGODB_URI=mongodb://localhost:27017/cart
ORDER_MONGODB_URI=mongodb://localhost:27017/order
PAYMENT_MONGODB_URI=mongodb://localhost:27017/payment
REVIEW_MONGODB_URI=mongodb://localhost:27017/review

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/order/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/cart