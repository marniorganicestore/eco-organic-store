JWT_SECRET=change-me-please-change-me-please-change-me-please
INTERNAL_API_KEY=internal-secret

# Browser origins allowed by the gateway (credentials CORS). Include the Azure storefront in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://eco-organic-store.com,https://www.eco-organic-store.com

# Cross-site SPA → API (default Azure hosts): COOKIE_SECURE=true and COOKIE_SAME_SITE=None
# After api.eco-organic-store.com is attached, Lax is enough (same-site).
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

GOOGLE_CLIENT_ID=
# Same value as GOOGLE_CLIENT_ID; bake into the Vite storefront for the Google button.
VITE_GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@eco-organic-store.com
ADMIN_NAME=Store Admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

IDENTITY_MONGODB_URI=mongodb://localhost:27017/identity
CATALOG_MONGODB_URI=mongodb://localhost:27017/catalog
INVENTORY_MONGODB_URI=mongodb://localhost:27017/inventory
CART_MONGODB_URI=mongodb://localhost:27017/cart
ORDER_MONGODB_URI=mongodb://localhost:27017/order
PAYMENT_MONGODB_URI=mongodb://localhost:27017/payment
REVIEW_MONGODB_URI=mongodb://localhost:27017/review

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public key only. Never put RAZORPAY_KEY_SECRET in a VITE_ variable.
VITE_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CALLBACK_URL=http://localhost:8080/api/payments/razorpay/callback
RAZORPAY_SUCCESS_URL=http://localhost:5173/order/success
RAZORPAY_CANCEL_URL=http://localhost:5173/cart

# Transactional mail is sent from admin@eco-organic-store.com.
# Order updates are copied to the same mailbox. Leave MAIL_ENABLED false to log messages locally.
# Example host for mailbox SMTP: smtp.office365.com or your provider's submission host, port 587.
MAIL_ENABLED=true
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=587
MAIL_USERNAME=admin@eco-organic-store.com
MAIL_PASSWORD=
MAIL_FROM=admin@eco-organic-store.com
MAIL_FROM_NAME=Marni Eco organic store
MAIL_ADMIN=admin@eco-organic-store.com
STOREFRONT_URL=http://localhost:5173